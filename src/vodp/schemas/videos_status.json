{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "vodp videos status JSON contract (M8, read-only diagnostic: status+processingDetails)",
  "type": "object",
  "required": [
    "run",
    "videos",
    "summary"
  ],
  "properties": {
    "run": {
      "type": "object",
      "required": [
        "run_id",
        "command",
        "started_at",
        "dry_run"
      ],
      "properties": {
        "run_id": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "started_at": {
          "type": "string"
        },
        "dry_run": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "videos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "twitch_vod_id",
          "youtube_video_id",
          "status",
          "reason_code"
        ],
        "properties": {
          "twitch_vod_id": {
            "type": "null"
          },
          "youtube_video_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "skipped",
              "failed"
            ]
          },
          "reason_code": {
            "enum": [
              null,
              "not_found"
            ]
          },
          "upload_status": {
            "type": [
              "string",
              "null"
            ]
          },
          "failure_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "rejection_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "privacy_status": {
            "type": [
              "string",
              "null"
            ]
          },
          "processing_status": {
            "type": [
              "string",
              "null"
            ]
          },
          "processing_failure_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "processing_progress": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "parts_total": {
                "type": [
                  "string",
                  "integer",
                  "null"
                ]
              },
              "parts_processed": {
                "type": [
                  "string",
                  "integer",
                  "null"
                ]
              },
              "time_left_ms": {
                "type": [
                  "string",
                  "integer",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "total",
        "uploaded",
        "skipped",
        "failed"
      ],
      "properties": {
        "total": {
          "type": "integer"
        },
        "uploaded": {
          "type": "integer"
        },
        "skipped": {
          "type": "integer"
        },
        "failed": {
          "type": "integer"
        },
        "error": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
